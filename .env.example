# ==============================================================================
# FrightFate Backend Environment Variables Template
# Copy to backend/.env and fill in your values.
# ==============================================================================

# Database Connection
# SQLite (default for development and simple single-node deployments):
DATABASE_URL=sqlite:///./frightfate.db
# PostgreSQL (for serverless/managed databases such as Neon, Supabase, or Railway):
# DATABASE_URL=postgresql://user:password@hostname:5432/frightfate

# AI Model Configuration (any OpenAI-compatible provider: OpenAI, Groq, DeepSeek,
# Ollama, Azure OpenAI, GitHub Models, ...)
# Your API key for the provider:
OPENAI_API_KEY=sk-your-api-key-here
# Provider base URL. Examples:
#   Groq:     https://api.groq.com/openai/v1
#   Ollama:   http://localhost:11434/v1
#   OpenAI:   (leave unset — the default is https://api.openai.com/v1)
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# Model id in provider/namespace form. Example (Groq):
# OPENAI_MODEL=openai/gpt-oss-120b
OPENAI_MODEL=gpt-4o-mini
# Optional second API key (same provider). Answer-scoring calls are routed
# here so the two biggest call types spend separate rate-limit budgets.
# OPENAI_API_KEY_2=gsk_your-second-key-here

# Security
SECRET_KEY=spooky-secret-key-change-this-in-production-1234
# Comma-separated list of CORS origins for the frontend.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,*

# Environment (development | production)
ENVIRONMENT=development
